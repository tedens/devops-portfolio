# Pinned once, read by scripts/ and by CI, so the two cannot drift.
KYVERNO_VERSION=v1.19.1
# v2, deliberately. cosign v3 writes only the Sigstore bundle format via OCI
# referrers, and Kyverno 1.19.1's ImageValidatingPolicy verifier does not
# find those: a correctly signed image is refused with "no signatures found",
# indistinguishable from an unsigned one. The SLSA generator pins cosign v2
# as well and writes legacy .att tags. One format, end to end.
COSIGN_VERSION=v2.6.5
SYFT_VERSION=v1.52.0
CRANE_VERSION=v0.22.1
KIND_NODE_IMAGE=kindest/node:v1.31.4
REGISTRY_IMAGE=registry:3
SLSA_GENERATOR_VERSION=v2.1.0
